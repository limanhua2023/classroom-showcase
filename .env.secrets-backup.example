SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

SECRETS_BACKUP_ROOT=secrets_backup
SECRETS_BACKUP_RETENTION=20
SECRETS_BACKUP_STATUS_PATH=system/project-secrets-backup-status.json
SECRETS_BACKUP_SOURCE_FILES=.env.local-backup.local,.env.project-backup.local,.env.render-backup.local
SECRETS_BACKUP_PASSPHRASE=
SECRETS_BACKUP_PASSPHRASE_HINT=

SECRETS_BACKUP_S3_BUCKET=classshow-archive-prod
SECRETS_BACKUP_S3_REGION=auto
SECRETS_BACKUP_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
SECRETS_BACKUP_S3_ACCESS_KEY_ID=
SECRETS_BACKUP_S3_SECRET_ACCESS_KEY=
SECRETS_BACKUP_CLOUD_PREFIX=classshow-system-backups/secrets
